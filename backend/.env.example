APP_NAME=KawalWarga
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

FRONTEND_URL=http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT=12
# true = tampilkan detail error Gemini di balasan chatbot (debugging lokal saja)
GEMINI_DEBUG=false

# Health check key (lindungi GET /health/ai)
HEALTH_KEY=

# Sanctum token expiration (menit); 720 = 12 jam
SANCTUM_TOKEN_EXPIRATION=720

# Password akun seeder (opsional, ganti di production sebelum submit final)
# DEMO_ADMIN_PASSWORD=password123
# DEMO_OFFICER_PASSWORD=password123
