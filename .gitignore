# ============================================================================
# KawalWarga Monorepo — Root .gitignore
# ============================================================================

# Backend (Laravel + SQLite)
backend/.env
backend/.env.*
!backend/.env.example
backend/database/*.sqlite
backend/database/*.sqlite-wal
backend/database/*.sqlite-shm
backend/public/uploads/*
!backend/public/uploads/.gitkeep
!backend/public/uploads/.htaccess
backend/vendor/
backend/node_modules/
backend/storage/*.key

# Frontend (Next.js Static Export)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example
frontend/*.tsbuildinfo

# Root & Build Artifacts
node_modules/
.next/
out/
dist/
build/
.env
.env.local
.env.*.local
!.env.example

# Internal Prompt Notes
docs/*-Prompt.md

# Local Test Media
contoh foto/

# OS & Editor Files
.DS_Store
Thumbs.db
*.pem
*.log
*.swp
*.swo
.idea/
.vscode/
.cursor/
.nova/
.zed/
